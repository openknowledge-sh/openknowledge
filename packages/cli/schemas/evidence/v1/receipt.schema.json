{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/evidence/v1/receipt.schema.json",
  "title": "Open Knowledge immutable evidence receipt",
  "type": "object",
  "required": ["type", "version", "id", "sha256", "bytes", "mediaType", "artifact", "originalResource", "capturedAt", "document", "sourceId"],
  "properties": {
    "type": {"const": "openknowledge.evidence-receipt"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^okf\\+sha256://[a-f0-9]{64}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "mediaType": {"type": "string", "minLength": 1},
    "artifact": {"type": "string", "minLength": 1},
    "originalResource": {"type": "string", "minLength": 1},
    "finalResource": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "format": "date-time"},
    "document": {"type": "string", "minLength": 1},
    "sourceId": {"type": "string", "minLength": 1},
    "sourceType": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "access": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(profile|agent|team|use_case):[^\\s]+$"}}
  },
  "additionalProperties": false
}
