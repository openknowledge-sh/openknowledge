{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/v1/claims-stale.schema.json",
  "title": "Open Knowledge stale claims result",
  "type": "object",
  "required": ["schemaVersion", "root", "claims", "issues"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "root": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "items": {"$ref": "claims-find.schema.json#/$defs/occurrence"}},
    "issues": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/issue"}}
  },
  "additionalProperties": false
}
