{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/v1/runtime-plan.schema.json",
  "title": "Open Knowledge runtime plan v1",
  "type": "object",
  "required": ["schemaVersion", "config", "stateDir", "artifactStore", "serve", "worker", "github", "knowledgeBases", "accessProfiles"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "config": {"type": "string", "minLength": 1},
    "stateDir": {"type": "string", "minLength": 1},
    "artifactStore": {"$ref": "#/$defs/artifactStore"},
    "serve": {"$ref": "#/$defs/serve"},
    "worker": {"$ref": "#/$defs/worker"},
    "github": {"$ref": "#/$defs/github"},
    "knowledgeBases": {"type": "array", "items": {"$ref": "#/$defs/knowledgeBase"}},
    "accessProfiles": {"type": "array", "items": {"$ref": "#/$defs/accessProfile"}},
    "requiredRuntimes": {
      "type": "array",
      "items": {"enum": ["codex", "claude", "opencode"]},
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifactStore": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {"enum": ["filesystem", "http"]},
        "path": {"type": "string"},
        "url": {"type": "string"},
        "token_env": {"type": "string"}
      },
      "additionalProperties": false
    },
    "serve": {
      "type": "object",
      "required": ["address", "poll_interval", "request_timeout", "max_concurrency", "mcp_access", "retrieval_policy", "usage_events"],
      "properties": {
        "address": {"type": "string"},
        "poll_interval": {"type": "string"},
        "request_timeout": {"type": "string"},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "mcp_access": {"type": "string"},
        "mcp_token_env": {"type": "string"},
        "allowed_origins": {"type": "array", "items": {"type": "string"}},
        "retrieval_policy": {"$ref": "#/$defs/retrievalPolicy"},
        "usage_events": {"$ref": "#/$defs/usageEvents"}
      },
      "additionalProperties": false
    },
    "retrievalPolicy": {
      "type": "object",
      "required": ["minimum_trust", "allow_stale", "allowed_statuses", "require_sources"],
      "properties": {
        "minimum_trust": {"enum": ["unverified", "machine-confirmed", "human-reviewed"]},
        "allow_stale": {"type": "boolean"},
        "allowed_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["draft", "stable", "deprecated"]}},
        "require_sources": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "usageEvents": {
      "type": "object",
      "required": ["enabled", "capture_queries", "retention"],
      "properties": {
        "enabled": {"type": "boolean"},
        "capture_queries": {"type": "boolean"},
        "retention": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": ["repo", "remote", "production_branch", "poll_interval", "run_jobs", "knowledge_ci", "jobs_path", "exchange_dir"],
      "properties": {
        "repo": {"type": "string"},
        "repository_url": {"type": "string"},
        "remote": {"type": "string"},
        "production_branch": {"type": "string"},
        "poll_interval": {"type": "string"},
        "run_jobs": {"type": "boolean"},
        "knowledge_ci": {"type": "boolean"},
        "jobs_path": {"type": "string"},
        "runtimes": {"type": "array", "items": {"enum": ["codex", "claude", "opencode"]}},
        "git_token_env": {"type": "string"},
        "exchange_dir": {"type": "string"},
        "exchange_url": {"type": "string"},
        "exchange_token_env": {"type": "string"}
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "required": ["enabled", "api_url", "repository", "draft_pull_request", "checks", "auto_merge_low_risk"],
      "properties": {
        "enabled": {"type": "boolean"},
        "api_url": {"type": "string"},
        "repository": {"type": "string"},
        "app_id": {"type": "integer"},
        "installation_id": {"type": "integer"},
        "private_key_file": {"type": "string"},
        "token_env": {"type": "string"},
        "draft_pull_request": {"type": "boolean"},
        "checks": {"type": "boolean"},
        "auto_merge_low_risk": {"type": "boolean"},
        "required_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      },
      "additionalProperties": false
    },
    "knowledgeBase": {
      "type": "object",
      "required": ["id", "path", "route", "spec", "publish", "mcp"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "route": {"type": "string"},
        "spec": {"type": "string", "minLength": 1},
        "publish": {"type": "boolean"},
        "mcp": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "accessProfile": {
      "type": "object",
      "required": ["id", "token_env", "knowledge_bases", "agents", "teams", "use_cases"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "token_env": {"type": "string", "minLength": 1},
        "knowledge_bases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "agents": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "teams": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "use_cases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "retrieval_policy": {"$ref": "#/$defs/retrievalPolicy"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
