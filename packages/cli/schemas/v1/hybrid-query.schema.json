{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/v1/hybrid-query.schema.json",
  "title": "Open Knowledge hybrid retrieval result v1",
  "type": "object",
  "required": ["schemaVersion", "root", "revision", "query", "routes", "fusion", "results", "rejections"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "root": {"type": "string"},
    "revision": {"$ref": "common.schema.json#/$defs/retrievalRevision"},
    "query": {"$ref": "#/$defs/query"},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "fusion": {
      "type": "object",
      "required": ["method", "rankConstant"],
      "properties": {"method": {"const": "rrf"}, "rankConstant": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "rejections": {"type": "array", "items": {"$ref": "#/$defs/rejection"}}
  },
  "$defs": {
    "filters": {
      "type": "object",
      "properties": {
        "types": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "datalogInput": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {"type": "string"},
        "rules": {"type": "string"},
        "ruleProfile": {"enum": ["openknowledge.safe/v1", "openknowledge.closed-world/v1"]}
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": ["limit"],
      "properties": {
        "text": {"type": "string"},
        "sparql": {"type": "string"},
        "datalog": {"$ref": "#/$defs/datalogInput"},
        "limit": {"type": "integer", "minimum": 1},
        "filters": {"$ref": "#/$defs/filters"}
      },
      "anyOf": [{"required": ["text"]}, {"required": ["sparql"]}, {"required": ["datalog"]}],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["name", "reason"],
      "properties": {
        "name": {"enum": ["bm25", "vector", "section-focus", "sparql", "datalog"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["route", "rank", "rrfScore"],
      "properties": {
        "route": {"enum": ["bm25", "vector", "section-focus", "sparql", "datalog", "sparql-source", "datalog-source"]},
        "rank": {"type": "integer", "minimum": 1},
        "rawScore": {"type": "number"},
        "rrfScore": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "rejection": {
      "type": "object",
      "required": ["route", "reason", "count"],
      "properties": {
        "route": {"enum": ["access-policy", "lifecycle-policy"]},
        "reason": {"type": "string"},
        "count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["kind", "key", "score", "components", "sources"],
      "properties": {
        "kind": {"enum": ["retrieved-text", "asserted-fact", "derived-fact"]},
        "key": {"type": "string"},
        "score": {"type": "number", "minimum": 0},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
        "text": {"$ref": "search-results.schema.json#/$defs/result"},
        "sparql": {"$ref": "sparql-query.schema.json#/$defs/binding"},
        "datalog": {"$ref": "datalog-query.schema.json#/$defs/result"},
        "sources": {"type": "array", "items": {"$ref": "datalog-query.schema.json#/$defs/source"}}
      },
      "oneOf": [{"required": ["text"]}, {"required": ["sparql"]}, {"required": ["datalog"]}],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
