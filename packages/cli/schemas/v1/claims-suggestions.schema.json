{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/v1/claims-suggestions.schema.json",
  "title": "Open Knowledge claim suggestions",
  "type": "object",
  "required": ["schemaVersion", "root", "suggestions"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "root": {"type": "string", "minLength": 1},
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
		"required": ["document", "heading", "excerpt", "suggestedOccurrenceId", "sourceIds", "reuseSlots", "status"],
        "properties": {
          "document": {"type": "string", "minLength": 1},
          "sectionRef": {"type": "string"},
          "heading": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string", "minLength": 1},
		  "suggestedOccurrenceId": {"type": "string", "minLength": 3},
          "sourceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
		  "reuseSlots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "status": {"const": "candidate"}
        }
      }
    }
  },
  "additionalProperties": false
}
