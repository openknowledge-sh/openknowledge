{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/v1/audit-report.schema.json",
  "title": "Open Knowledge audit report",
  "type": "object",
  "required": ["type", "version", "bundle", "evaluatedAt", "summary", "findings", "sources"],
  "properties": {
    "type": {"const": "openknowledge.audit-report"},
    "version": {"const": 1},
    "bundle": {
      "type": "object",
      "required": ["path", "spec", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "spec": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object",
      "required": ["total", "high", "medium", "low"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "sources": {
      "type": "object",
      "required": ["current", "changed", "missing"],
      "properties": {
        "current": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "category", "severity", "title", "impact", "targets", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{20}$"},
        "category": {"enum": ["stale", "missing-source", "missing-owner", "broken-dependency", "identical-body", "duplicate-title", "claim-conflict", "missing-source-resource", "source-changed", "unanswered-question", "high-use-unverified"]},
        "severity": {"enum": ["high", "medium", "low"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "impact": {"type": "string", "minLength": 1, "maxLength": 1024},
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["field", "value"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1, "maxLength": 256},
        "value": {"type": "string", "maxLength": 8192}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
