{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/v1/artifact.schema.json",
  "title": "Open Knowledge durable artifact manifest",
  "type": "object",
  "required": ["type", "version", "kind", "runId", "base", "createdAt", "files"],
  "properties": {
    "type": {"const": "openknowledge.artifact"},
    "version": {"const": 1},
    "kind": {"enum": ["eval-comparison", "audit-report", "claims-validation", "knowledge-ci"]},
    "runId": {"type": "string", "minLength": 1},
    "base": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
