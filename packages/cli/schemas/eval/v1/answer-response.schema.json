{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/eval/v1/answer-response.schema.json",
  "title": "Open Knowledge eval answer response v1",
  "type": "object",
  "required": ["schemaVersion", "answers"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "answer", "claims"],
        "properties": {
          "caseId": {"type": "string"},
          "decision": {"enum": ["answer", "abstain"]},
          "answer": {"type": "string"},
          "refusalReasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scope": {"type": "object", "additionalProperties": {"type": "string"}},
          "applicableAt": {"type": "string"},
          "uncertainty": {"type": "string"},
          "citationEntailment": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/entailment"}},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "citations"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "citations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"decision": {"const": "abstain"}}, "required": ["decision"]}, "then": {"required": ["refusalReasons"], "properties": {"claims": {"maxItems": 0}}}},
          {"if": {"properties": {"decision": {"const": "answer"}}, "required": ["decision"]}, "then": {"properties": {"refusalReasons": {"maxItems": 0}}}}
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "entailment": {
      "type": "object",
      "required": ["locator", "status"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "status": {"enum": ["entailed", "not_entailed", "unverified"]},
        "method": {"type": "string", "minLength": 1},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
