{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledge.sh/schemas/cli/eval/v1/claim-replay-dataset.schema.json",
  "title": "Open Knowledge Claim Replay Eval Dataset v1",
  "type": "object",
  "required": ["type", "version", "id", "checkpoints"],
  "properties": {
    "type": {"const": "openknowledge.claim-replay-eval"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/checkpoint"}
    }
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "expectations": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/expectation"}
        }
      },
      "additionalProperties": false
    },
    "expectation": {
      "type": "object",
      "required": ["claim_id", "state"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "state": {"enum": ["supported", "refuted", "unverified"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
