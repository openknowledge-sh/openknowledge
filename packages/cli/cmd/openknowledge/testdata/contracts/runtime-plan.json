{
  "schemaVersion": "1",
  "config": "/workspace/runtime.toml",
  "stateDir": "/state",
  "artifactStore": {
    "type": "filesystem",
    "path": "/state/artifacts"
  },
  "serve": {
    "address": "127.0.0.1:8080",
    "poll_interval": "5s",
    "request_timeout": "15s",
    "max_concurrency": 32,
    "mcp_access": "public",
    "retrieval_policy": {
      "minimum_trust": "unverified",
      "allow_stale": true,
      "allowed_statuses": [
        "draft",
        "stable",
        "deprecated"
      ],
      "require_sources": false
    },
    "usage_events": {
      "enabled": false,
      "capture_queries": false,
      "retention": "720h"
    }
  },
  "worker": {
    "repo": "/workspace",
    "remote": "origin",
    "production_branch": "main",
    "poll_interval": "30s",
    "run_jobs": true,
    "jobs_path": ".openknowledge/jobs",
    "runtimes": [
      "codex"
    ],
    "exchange_dir": "/state/exchange"
  },
  "github": {
    "enabled": false,
    "api_url": "https://api.github.com",
    "repository": "example/docs",
    "draft_pull_request": true,
    "checks": true,
    "auto_merge_low_risk": false
  },
  "knowledgeBases": [
    {
      "id": "docs",
      "path": "/workspace/Wiki",
      "route": "/",
      "spec": "0.1",
      "publish": true,
      "mcp": false
    }
  ],
  "accessProfiles": [
    {
      "id": "support",
      "token_env": "SUPPORT_KNOWLEDGE_TOKEN",
      "knowledge_bases": [
        "docs"
      ],
      "agents": [
        "support-agent"
      ],
      "teams": [
        "support"
      ],
      "use_cases": [
        "customer-support"
      ],
      "retrieval_policy": {
        "minimum_trust": "human-reviewed",
        "allow_stale": false,
        "allowed_statuses": [
          "stable"
        ],
        "require_sources": true
      }
    }
  ],
  "requiredRuntimes": [
    "codex"
  ]
}
