{
  "name": "openknowledge-monorepo",
  "private": true,
  "version": "0.11.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev:web": "pnpm --filter @openknowledge-sh/web dev",
    "dev:viewer": "pnpm --filter @openknowledge-sh/web dev:viewer",
    "build:web": "pnpm --filter @openknowledge-sh/web build",
    "build:viewer": "pnpm --filter @openknowledge-sh/web build:viewer",
    "test:cli": "pnpm build:viewer && go test ./packages/cli/...",
    "test:install": "bash scripts/test-install.sh",
    "test:npm-install": "node --test packages/npm/install.test.js",
    "test:packed-npm": "node scripts/test-packed-npm.mjs",
    "test:demos": "bash scripts/test-demo-knowledge-bases.sh",
    "test:web": "pnpm --filter @openknowledge-sh/web test",
    "test:browser": "pnpm --filter @openknowledge-sh/web test:browser",
    "test:race": "pnpm build:viewer && go test -race ./packages/cli/...",
    "test:coverage": "pnpm build:viewer && go test -covermode=atomic -coverprofile=coverage.out ./packages/cli/...",
    "build:cli": "pnpm build:viewer && go build -o bin/openknowledge ./packages/cli/cmd/openknowledge",
    "check:format": "bash scripts/check-gofmt.sh",
    "check:versions": "node scripts/check-versions.mjs",
    "check:workflow-pins": "node scripts/check-workflow-pins.mjs",
    "check:workflow-secret-scope": "node scripts/check-workflow-secret-scope.mjs",
    "check:workflow-permissions": "go -C packages/cli run ./internal/tools/checkworkflowpermissions",
    "check:security-config": "node scripts/check-security-config.mjs",
    "check:container-runtime": "node scripts/check-container-runtime.mjs",
    "check:repo-jobs": "pnpm build:viewer && go run ./packages/cli/cmd/openknowledge automation jobs validate .openknowledge/jobs",
    "test": "pnpm build:viewer && pnpm check:format && pnpm check:versions && pnpm check:workflow-pins && pnpm check:workflow-secret-scope && pnpm check:workflow-permissions && pnpm check:security-config && pnpm check:container-runtime && go run ./packages/cli/cmd/openknowledge automation jobs validate .openknowledge/jobs && pnpm test:install && pnpm test:npm-install && pnpm test:packed-npm && pnpm test:demos && pnpm test:web && go test ./packages/cli/...",
    "build": "pnpm build:web && go build -o bin/openknowledge ./packages/cli/cmd/openknowledge"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  },
  "pnpm": {
    "overrides": {
      "nanoid@3.3.16": "3.3.17"
    }
  }
}
